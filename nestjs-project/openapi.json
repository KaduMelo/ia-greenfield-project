          "width",
          "height",
          "sizeBytes",
          "formatName",
          "thumbnailUrl",
          "createdAt",
          "processedAt"
        ]
      },
      "PlaybackUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
